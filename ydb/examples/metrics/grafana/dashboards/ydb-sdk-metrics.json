      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Client construction rate",
      "datasource": { "type": "prometheus", "uid": "victoria" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "spanNulls": false } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) (rate({__name__=~\"ydb_new_(client|table_client|query_client|scheme_client|topic_client)_counter\", driver_name=\"metrics-example\"}[$__rate_interval]))",
          "legendFormat": "{{__name__}}",
          "range": true
        }
      ]
    },
